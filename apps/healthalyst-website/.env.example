# healthalyst website environment template
# Copy this file to `.env.local` and fill in values. Never commit `.env.local`.

# Public site URL used for the canonical and Open Graph tags
# (src/app/layout.tsx). Only values that are safe to expose to visitors.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon (or any PostgreSQL) connection string for the contact enquiry table.
# Server-only: read by src/app/api/contact/route.ts, so it must never use a
# NEXT_PUBLIC_ prefix. Get it from the Neon dashboard (Settings -> Connection
# string), then apply db/contact-enquiries.sql and db/job-applications.sql to that
# database once before the first contact enquiry or job application.
DATABASE_URL="postgresql://user:password@ep-xxxx.region.neon.tech/neondb?sslmode=verify-full"

# Resend credentials for sending an acknowledgement after a new enquiry is saved.
# Create an API key in Resend and use a sender address on a verified domain.
# Server-only: never prefix either value with NEXT_PUBLIC_.
RESEND_API_KEY="re_your_api_key"
RESEND_FROM_EMAIL="Healthalyst Africa <your-verified-sender@your-domain.com>"

# Google Gemini key for the AI question box under the homepage FAQ
# (src/app/api/faq-assistant/route.ts). Create one at https://aistudio.google.com
# (Get API key). Server-only: never prefix it with NEXT_PUBLIC_. Without it the
# box still shows, but answers that the assistant is unavailable.
GOOGLE_GENERATIVE_AI_API_KEY=""
# Optional: one Gemini model to use instead of the default, which tries
# gemini-flash-lite-latest and then gemini-flash-latest.
# GEMINI_MODEL=""

# The organisation app (healthalyst-frontend), where the header's Get started
# (sign up) and Sign in buttons lead. Public: it is a link visitors see.
# Optional: production defaults to https://account.healthalystafrica.com and
# development to http://localhost:3005. Set it only to point elsewhere, such
# as a staging app.
NEXT_PUBLIC_HEALTHALYST_ORGANIZATION_APP_URL=""
