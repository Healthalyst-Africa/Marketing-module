# Copy this file to `.env` and fill in your team's values.
# Never commit `.env` or any real value.
#
# Named `env.example` (not `.env.example`) because the repo's file policy
# blocks any `.env.*` file.

# Public site URL (canonical + Open Graph tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form endpoint — leave empty to keep the form client-side only
NEXT_PUBLIC_CONTACT_ENDPOINT=
