{
  "name": "@healthalyst/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./styles.css": "./src/styles.css",
    "./components/*": "./src/components/*.tsx",
    "./primitives/*": "./src/primitives/*.tsx",
    "./illustrations/*": "./src/illustrations/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./config/*": "./src/config/*.ts",
    "./types/*": "./src/types/*.ts",
    "./forms/*": "./src/forms/*.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@healthalyst/icons": "workspace:*",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-radio-group": "^1.4.8",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.1.16",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.22",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "tailwind-merge": "^2.6.1"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "devDependencies": {
    "@healthalyst/eslint-config": "workspace:*",
    "@healthalyst/typescript-config": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.7",
    "eslint": "^10.12.0",
    "typescript": "^5.9.3"
  }
}
